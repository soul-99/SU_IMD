<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared here because this is the module that asks: the IMD+ page's "Disable battery
      optimisations" button fires ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, and that
      screen refuses to open at all unless the calling app holds this permission. It grants
      nothing by itself - it only permits the request, which the user still answers.

      Play Store distribution restricts this permission; IMD ships through F-Droid and GitHub.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

</manifest>
