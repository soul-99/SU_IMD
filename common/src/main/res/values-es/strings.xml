<resources>
    <!--
      Spanish. Machine translation, reviewed for consistency of terminology.

      Left in English on purpose: "System", "Secure" and "Global" name Android's three
      settings tables, and a translated label would no longer match what the platform, its
      documentation or any adb command calls them. Shizuku is a product name.

      Terminology follows Android's own Spanish: "Ajustes", "opciones de desarrollador",
      "servicios de accesibilidad", "depuración USB", "acceso directo". "Revertir" is the
      one verb used for revert everywhere in the app.
    -->
    <string name="add">Añadir</string>
    <string name="update">Actualizar</string>
    <string name="cancel">Cancelar</string>
    <string name="system">System</string>
    <string name="secure">Secure</string>
    <string name="global">Global</string>

    <string name="language_system">Sistema / automático</string>
    <string name="language_ai_notice">Los idiomas distintos del inglés se han generado con traducción automática asistida por IA, por lo que pueden contener errores. Si quieres que se corrijan, informa de los errores de traducción al desarrollador en el gestor de incidencias de GitHub.</string>

    <string name="revert_to_default_toast">Revertir a valores predeterminados</string>
    <string name="revert_from_memory_toast">Revertir desde la memoria</string>
    <string name="revert_failed_shizuku_toast">No se ha podido reiniciar el servicio Shizuku</string>
    <string name="revert_failed_overlay_toast">No se ha podido restaurar el permiso Mostrar sobre otras aplicaciones con Shizuku, consulta la notificación</string>
    <string name="revert_failed_shizuku_and_overlay_toast">No se han podido restaurar el servicio Shizuku ni los permisos Mostrar sobre otras aplicaciones</string>
    <string name="settings_hidden_toast">Ajustes ocultados</string>
    <string name="auto_revert_to_default_toast">Reversión automática a los valores predeterminados</string>
    <string name="auto_revert_from_memory_toast">Reversión automática con la Memory function</string>
</resources>
