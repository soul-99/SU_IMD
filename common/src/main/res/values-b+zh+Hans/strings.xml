<resources>
    <!--
      Simplified Chinese (zh-Hans). Machine translation, reviewed for consistency of
      terminology. Mainland conventions.

      Left in English on purpose: "System", "Secure" and "Global" name Android's three
      settings tables, and a translated label would no longer match what the platform, its
      documentation or any adb command calls them. Shizuku is a product name.

      "Revert" is 还原 throughout every module, and "revert to default" is 还原为默认.
    -->
    <string name="add">添加</string>
    <string name="update">更新</string>
    <string name="cancel">取消</string>
    <string name="system">System</string>
    <string name="secure">Secure</string>
    <string name="global">Global</string>

    <string name="language_system">系统 / 自动</string>
    <string name="language_ai_notice">除英语以外的语言均由 AI 辅助的机器翻译生成，因此可能存在错误。如果您希望得到修正，建议在 GitHub 问题追踪器中向开发者反馈翻译错误。</string>

    <string name="revert_to_default_toast">还原为默认</string>
    <string name="revert_from_memory_toast">从记忆还原</string>
</resources>
