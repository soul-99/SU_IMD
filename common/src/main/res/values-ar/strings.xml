<resources>
    <!--
      Arabic. Machine translation, reviewed for consistency of terminology.

      Left in English on purpose: "System", "Secure" and "Global" name Android's three
      settings tables, and a translated label would no longer match what the platform, its
      documentation or any adb command calls them. Shizuku is a product name.

      Right to left, so two conventions run through every Arabic file here: menu paths are
      written with ← rather than →, since the reader moves that way, and digits stay Western
      (0-9) to match what the format specifiers substitute in.
    -->
    <string name="add">إضافة</string>
    <string name="update">تحديث</string>
    <string name="cancel">إلغاء</string>
    <string name="system">System</string>
    <string name="secure">Secure</string>
    <string name="global">Global</string>

