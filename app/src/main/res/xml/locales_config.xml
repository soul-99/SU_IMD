<!--
  What Android's own per-app language screen offers, on Android 13 and up. The order here
  does not reach the user; that screen sorts by its own rules. The order the app's picker
  uses lives in AppLocale.LANGUAGES.

  English is listed first and is the fallback: a system language that is not one of these
  resolves to the default res/values, which is English.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pt-BR" />
    <locale android:name="es" />
    <locale android:name="zh-Hans" />
    <locale android:name="fr" />
    <locale android:name="de" />
    <locale android:name="ru" />
    <locale android:name="hi" />
    <locale android:name="ar" />
    <locale android:name="ko" />
    <locale android:name="ja" />
</locale-config>
